datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  // previewFeatures = ["driverAdapters"]  -- no longer needed in Prisma 7
}

enum EventType {
  FREE
  PAID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OwnerType {
  INTERNAL
  PARTNER
}

enum RegistrationStatus {
  RESERVED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  contactEmail String
  contactPhone String
  createdAt    DateTime @default(now())
  events       Event[]
}

model Event {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String
  category       String
  type           EventType      @default(FREE)
  priceKes       Int            @default(0)
  capacity       Int?
  startsAt       DateTime
  location       String
  status         EventStatus    @default(DRAFT)
  ownerType      OwnerType      @default(INTERNAL)
  partnerId      String?
  partner        Partner?       @relation(fields: [partnerId], references: [id])
  commissionRate Float          @default(0.15)
  imageUrl       String?
  createdAt      DateTime       @default(now())
  registrations  Registration[]
  payments       Payment[]
}

model Registration {
  id         String             @id @default(cuid())
  eventId    String
  guestName  String
  guestEmail String
  guestPhone String?
  status     RegistrationStatus @default(RESERVED)
  createdAt  DateTime           @default(now())
  event      Event              @relation(fields: [eventId], references: [id])
  payment    Payment?

  @@unique([eventId, guestEmail])
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model Project {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  category          String
  desc              String
  problem           String
  approach          String
  outcome           String
  metrics           String[]
  team              String[]
  duration          String
  status            ProjectStatus @default(DRAFT)
  clientName        String?
  coverImageUrl     String?
  liveUrl           String?
  tags              String[]
  featured          Boolean       @default(false)
  testimonial       String?
  testimonialAuthor String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Payment {
  id                 String        @id @default(cuid())
  registrationId     String        @unique
  eventId            String
  amountKes          Int
  status             PaymentStatus @default(PENDING)
  provider           String        @default("MPESA")
  merchantRequestId  String?
  checkoutRequestId  String?       @unique
  mpesaReceiptNumber String?
  phone              String?
  rawCallback        Json?
  commissionKes      Int?
  partnerShareKes    Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  registration       Registration  @relation(fields: [registrationId], references: [id])
  event              Event         @relation(fields: [eventId], references: [id])
}

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  role           String
  title          String
  course         String
  year           String
  bio            String
  focus          String[]
  quote          String
  socials        Json
  avatarGradient String[]
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Singleton row (id = "home") holding all editable homepage copy.
model HomeContent {
  id String @id @default("home")

  heroEyebrow           String
  heroTitleLine1        String
  heroTitleLine2        String
  heroTitleAccent       String
  heroSubtitle          String
  heroPrimaryCtaLabel   String
  heroPrimaryCtaHref    String
  heroSecondaryCtaLabel String
  heroSecondaryCtaHref  String

  missionEyebrow     String
  missionTitle       String
  missionTitleAccent String
  missionBody        String

  visionEyebrow     String
  visionTitle       String
  visionTitleAccent String
  visionBody        String

  storyEyebrow    String
  storyHeading    String
  storyParagraph1 String
  storyParagraph2 String

  stat1Value Int
  stat1Label String
  stat2Value Int
  stat2Label String
  stat3Value Int
  stat3Label String

  insideEyebrow     String
  insideTitleStart  String
  insideTitleAccent String
  insideSubtitle    String
  insideTile1Label  String
  insideTile2Label  String
  insideTile3Label  String
  insideTile4Label  String

  updatedAt DateTime @updatedAt
}
