datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  // previewFeatures = ["driverAdapters"]  -- no longer needed in Prisma 7
}

enum EventType {
  FREE
  PAID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OwnerType {
  INTERNAL
  PARTNER
}

enum RegistrationStatus {
  RESERVED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  contactEmail String
  contactPhone String
  createdAt    DateTime @default(now())
  events       Event[]
}

model Event {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String
  category       String
  type           EventType      @default(FREE)
  priceKes       Int            @default(0)
  capacity       Int?
  startsAt       DateTime
  location       String
  status         EventStatus    @default(DRAFT)
  ownerType      OwnerType      @default(INTERNAL)
  partnerId      String?
  partner        Partner?       @relation(fields: [partnerId], references: [id])
  commissionRate Float          @default(0.15)
  createdAt      DateTime       @default(now())
  registrations  Registration[]
  payments       Payment[]
}

model Registration {
  id         String             @id @default(cuid())
  eventId    String
  guestName  String
  guestEmail String
  guestPhone String?
  status     RegistrationStatus @default(RESERVED)
  createdAt  DateTime           @default(now())
  event      Event              @relation(fields: [eventId], references: [id])
  payment    Payment?

  @@unique([eventId, guestEmail])
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model Project {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  category          String
  desc              String
  problem           String
  approach          String
  outcome           String
  metrics           String[]
  team              String[]
  duration          String
  status            ProjectStatus @default(DRAFT)
  clientName        String?
  coverImageUrl     String?
  liveUrl           String?
  tags              String[]
  featured          Boolean       @default(false)
  testimonial       String?
  testimonialAuthor String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Payment {
  id                 String        @id @default(cuid())
  registrationId     String        @unique
  eventId            String
  amountKes          Int
  status             PaymentStatus @default(PENDING)
  provider           String        @default("MPESA")
  merchantRequestId  String?
  checkoutRequestId  String?       @unique
  mpesaReceiptNumber String?
  phone              String?
  rawCallback        Json?
  commissionKes      Int?
  partnerShareKes    Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  registration       Registration  @relation(fields: [registrationId], references: [id])
  event              Event         @relation(fields: [eventId], references: [id])
}
